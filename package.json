{
  "name": "tainakanchu-tools",
  "version": "1.0.0",
  "description": "かんちゅが作る日常の小さな便利ツール集。原寸レイアウトメーカーなど、原寸レイアウトにこだわったユーティリティを公開中。",
  "author": "tainakanchu (https://x.com/tainakanchu)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://tools.tainakanchu.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/tainakanchu/tainakanchu-tools.git"
  },
  "bugs": {
    "url": "https://github.com/tainakanchu/tainakanchu-tools/issues"
  },
  "keywords": [
    "tools",
    "utilities",
    "actual-size-layout",
    "print",
    "react",
    "vite",
    "typescript"
  ],
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build && tsc",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "prettier",
    "check": "prettier --write . && oxlint --fix",
    "typecheck": "tsc --noEmit",
    "og:images": "node scripts/generate-og-images.ts",
    "taiwan:validate": "node scripts/build-taiwan-map-data.ts --validate",
    "taiwan:build-data": "node scripts/build-taiwan-map-data.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "cf:dev": "pnpm run build && wrangler dev"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mediabunny/mp3-encoder": "^1.65.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.48",
    "fflate": "^0.8.3",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "^5.24.0",
    "mediabunny": "^1.65.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "temporal-polyfill": "^1.0.8",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "web-vitals": "^6.2.3",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@10.32.1"
}
