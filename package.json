{
  "name": "tainakanchu-tools",
  "version": "1.0.0",
  "description": "かんちゅが作る日常の小さな便利ツール集。原寸レイアウトメーカーなど、原寸レイアウトにこだわったユーティリティを公開中。",
  "author": "tainakanchu (https://x.com/tainakanchu)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://tools.tainakanchu.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/tainakanchu/tainakanchu-tools.git"
  },
  "bugs": {
    "url": "https://github.com/tainakanchu/tainakanchu-tools/issues"
  },
  "keywords": [
    "tools",
    "utilities",
    "actual-size-layout",
    "print",
    "react",
    "vite",
    "typescript"
  ],
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build && tsc",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "prettier",
    "check": "prettier --write . && oxlint --fix",
    "typecheck": "tsc --noEmit",
    "og:images": "node scripts/generate-og-images.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "cf:dev": "pnpm run build && wrangler dev"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.23",
    "lucide-react": "^1.28.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "web-vitals": "^6.0.1",
    "wrangler": "^4.118.0"
  },
  "packageManager": "pnpm@10.32.1"
}
